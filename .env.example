# Example environment variables; replace placeholders locally, never commit secrets.
RTSP_FACE=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/stream1
RTSP_OBJECT=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/stream2
FIREBASE_CREDENTIALS=/absolute/path/to/private-firebase-service-account.json
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
